{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exord-init.dev/schema/task-draft-v1.json",
  "title": "Local task draft identity v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "draft_id", "task_id", "created_at", "project_id", "target_identity_sha256", "work_branch"],
  "properties": {
    "schema_version": {"const": 1},
    "draft_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{8}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "format": "uuid"},
    "target_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "work_branch": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
