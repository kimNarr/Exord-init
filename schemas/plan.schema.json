{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exord-init.dev/schema/plan-v1.json",
  "title": "exord-init Setup Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "target_fingerprint", "spec", "spec_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "format": "uuid"},
    "target_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "depth", "project_id", "target_identity_sha256", "target_fingerprint", "operations", "validation", "risk_summary"],
      "properties": {
        "mode": {"enum": ["CREATE", "ADOPT", "REINITIALIZE", "UPGRADE"]},
        "depth": {"enum": ["QUICK", "CUSTOM"]},
        "project_id": {"type": "string", "format": "uuid"},
        "target_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "target_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "validation": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
        "risk_summary": {"$ref": "#/$defs/riskSummary"},
        "adopt_analysis": {"$ref": "#/$defs/adoptAnalysis"},
        "upgrade_analysis": {"$ref": "#/$defs/upgradeAnalysis"}
      }
    },
    "spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "template_id", "expected_sha256"],
      "properties": {
        "kind": {"const": "CREATE"},
        "path": {"type": "string", "minLength": 1},
        "template_id": {"type": "string", "minLength": 1},
        "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string"}
      }
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destructive_operations", "user_owned_files_touched", "outside_root_paths", "secret_warnings"],
      "properties": {
        "destructive_operations": {"type": "integer", "minimum": 0},
        "user_owned_files_touched": {"type": "integer", "minimum": 0},
        "outside_root_paths": {"type": "integer", "minimum": 0},
        "secret_warnings": {"type": "integer", "minimum": 0}
      }
    },
    "adoptAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "git", "task", "guidance", "conflicts"],
      "properties": {
        "inventory": {"$ref": "#/$defs/inventorySummary"},
        "git": {"$ref": "#/$defs/gitAnalysis"},
        "task": {"$ref": "#/$defs/taskAnalysis"},
        "guidance": {"type": "array", "items": {"$ref": "#/$defs/guidanceAnalysis"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
      }
    },
    "inventorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "directories", "symlinks", "special_files", "excluded_directories", "large_files", "unhashed_files", "nested_git_repositories", "secret_candidates", "secret_scan_limited", "total_bytes"],
      "properties": {
        "files": {"type": "integer", "minimum": 0},
        "directories": {"type": "integer", "minimum": 0},
        "symlinks": {"type": "integer", "minimum": 0},
        "special_files": {"type": "integer", "minimum": 0},
        "excluded_directories": {"type": "integer", "minimum": 0},
        "large_files": {"type": "integer", "minimum": 0},
        "unhashed_files": {"type": "integer", "minimum": 0},
        "nested_git_repositories": {"type": "integer", "minimum": 0},
        "secret_candidates": {"type": "integer", "minimum": 0},
        "secret_scan_limited": {"type": "boolean"},
        "total_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "gitAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected", "cli_available", "root_match", "git_file", "branch", "head", "unborn", "tracked_dirty", "untracked_files", "in_progress", "status"],
      "properties": {
        "detected": {"type": "boolean"},
        "cli_available": {"type": "boolean"},
        "root_match": {"type": "boolean"},
        "git_file": {"type": "boolean"},
        "branch": {"type": "string"},
        "head": {"type": "string"},
        "unborn": {"type": "boolean"},
        "tracked_dirty": {"type": "boolean"},
        "untracked_files": {"type": "integer", "minimum": 0},
        "in_progress": {"type": "string"},
        "status": {"enum": ["NOT_GIT", "OK", "CLI_UNAVAILABLE", "INVALID_REPOSITORY", "NESTED_DIRECTORY", "STATUS_UNAVAILABLE"]}
      }
    },
    "taskAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "alternative_path"],
      "properties": {
        "path": {"type": "string"},
        "status": {"enum": ["MISSING", "EXORD_TASK", "USER_OWNED", "LINKED_PATH", "UNREADABLE"]},
        "alternative_path": {"type": "string"}
      }
    },
    "guidanceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"enum": ["MISSING", "LINKED_PATH", "TYPE_CONFLICT", "USER_OWNED", "MANAGED_UNMODIFIED", "MANAGED_MODIFIED"]},
        "actual_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "options"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DIFF", "SKIP", "ALTERNATE_PATH", "KEEP", "REVIEW_UPDATE"]}}
      }
    },
    "upgradeAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_schema_version", "generator", "settings", "git_consistent", "files", "disposition"],
      "properties": {
        "manifest_schema_version": {"const": 1},
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recorded", "current", "direction"],
          "properties": {
            "recorded": {"type": "string"},
            "current": {"type": "string"},
            "direction": {"enum": ["UPGRADE", "SAME", "DOWNGRADE", "UNKNOWN"]}
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["git_mode", "branch_profile", "documentation_language", "supported_agents"],
          "properties": {
            "git_mode": {"type": "string"},
            "branch_profile": {"type": "string"},
            "documentation_language": {"type": "string"},
            "supported_agents": {"type": "array", "items": {"type": "string"}}
          }
        },
        "git_consistent": {"type": "boolean"},
        "disposition": {"enum": ["UP_TO_DATE", "UPGRADE_AVAILABLE", "REVIEW_REQUIRED", "BLOCKED"]},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "template_id", "update_policy", "recorded_template_version", "current_template_version", "local_state", "upgrade_action"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "template_id": {"type": "string"},
              "update_policy": {"type": "string"},
              "recorded_template_version": {"type": "integer", "minimum": 0},
              "current_template_version": {"type": "integer", "minimum": 0},
              "local_state": {"enum": ["REGULAR", "SYMLINK", "MISSING", "TYPE_CONFLICT", "UNREADABLE", "UNKNOWN_HASH_MODE", "UNTRACKED_BY_MANIFEST"]},
              "upgrade_action": {"enum": ["UP_TO_DATE", "TEMPLATE_UPDATE_AVAILABLE", "PROPOSE_ONLY_UPDATE", "REVIEW_LOCAL_EDIT", "RECREATE_MISSING", "NEW_MANAGED_FILE", "ADOPT_EXISTING_FILE", "ORPHAN_MANAGED_FILE", "BLOCKED"]}
            }
          }
        }
      }
    }
  }
}
