{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exord-init.dev/schema/recovery-v1.json",
  "title": "exord-init Recovery Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_id", "spec_sha256", "status", "stage", "disposition", "recoverable", "already_absent", "conflicts", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["ACTIVE", "BLOCKED", "FAILED", "RECOVERY_REQUIRED", "FINALIZED"]},
    "stage": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["ROLLBACK_READY", "CONFLICT", "CLEANUP_REQUIRED", "ROLLED_BACK_RETAINED", "NOT_RECOVERABLE"]},
    "recoverable": {"type": "integer", "minimum": 0},
    "already_absent": {"type": "integer", "minimum": 0},
    "conflicts": {"type": "integer", "minimum": 0},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "journal_status", "current_state", "recovery_action"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "journal_status": {"enum": ["PENDING", "APPLYING", "APPLIED", "ROLLED_BACK"]},
          "current_state": {"enum": ["MISSING", "MATCHED", "MODIFIED", "TYPE_CONFLICT", "UNREADABLE"]},
          "recovery_action": {"enum": ["NONE", "REMOVE", "MARK_ROLLED_BACK", "BLOCK"]}
        }
      }
    }
  }
}
